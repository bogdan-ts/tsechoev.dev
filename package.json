{
  "name": "tsechoev.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "preview": "sirv out --host 127.0.0.1 --port 3000",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "generate:globe": "node --experimental-strip-types scripts/generate-globe-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "benchmark:globe": "node --experimental-strip-types scripts/benchmark-globe.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "d3-geo": "3.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "sirv-cli": "3.0.1",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2",
    "@types/topojson-specification": "1.0.5"
  },
  "dependencies": {
    "@fontsource/martian-mono": "5.3.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
